<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Gazebo (new) version of this file. Included from example_robot.urdf.xacro. -->
    <!-- The old Gazebo Classic material tags are removed: the new Gazebo uses the
            colours from the URDF visual material tags instead. -->


    <!-- Publishes joint_states for the selected joints, which robot_state_publisher
            then uses to broadcast the tf. -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>slider_joint</joint_name>
            <joint_name>arm_joint</joint_name>
        </plugin>
    </gazebo>


    <!-- One position controller per joint. These replace the old joint pose trajectory
            plugin. Send a Float64 to /slider_joint/cmd_pos or /arm_joint/cmd_pos.
            The gains are starting guesses: tune them if a joint jitters or lags. -->
    <gazebo>
        <plugin filename="gz-sim-joint-position-controller-system"
                name="gz::sim::systems::JointPositionController">
            <joint_name>slider_joint</joint_name>
            <topic>slider_joint/cmd_pos</topic>
            <p_gain>50</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>1</d_gain>
        </plugin>
        <plugin filename="gz-sim-joint-position-controller-system"
                name="gz::sim::systems::JointPositionController">
            <joint_name>arm_joint</joint_name>
            <topic>arm_joint/cmd_pos</topic>
            <p_gain>50</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>1</d_gain>
        </plugin>
    </gazebo>


    <!-- Camera. An extra link and joint give the optical frame, which ROS uses
            for the correct image orientation. -->

    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.571 0 -1.571" />
        <parent link="camera_link" />
        <child link="camera_link_optical" />
    </joint>

    <link name="camera_link_optical"></link>


    <!-- Plain RGB camera for now. The old sensor was a depth camera, which is a
            different sensor type in the new Gazebo, so add that once this works. -->
    <gazebo reference="camera_link">
        <sensor type="camera" name="my_camera">
            <always_on>true</always_on>
            <update_rate>20</update_rate>
            <visualize>true</visualize>
            <topic>camera/image_raw</topic>
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <camera name="cam">
                <camera_info_topic>camera/camera_info</camera_info_topic>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>300</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>

</robot>
